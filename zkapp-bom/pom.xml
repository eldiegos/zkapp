<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.zkapp</groupId>
        <artifactId>zkapp</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>zkapp-bom</artifactId>
    <packaging>pom</packaging>

    <name>zkapp-bom</name>
    <description>Bill of Materials con las versiones de la plataforma zkapp y sus dependencias de plataforma</description>

    <properties>
        <!-- ZK CE, distribuida en Maven Central bajo el groupId org.zkoss.zk. El sufijo -jakarta
             indica el build sobre Jakarta Servlet (Jakarta EE), el requerido por Tomcat 11 /
             Spring Boot 4. -->
        <zk.version>10.3.0.1-jakarta</zk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot platform BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- zkapp platform modules -->
            <dependency>
                <groupId>com.example.zkapp</groupId>
                <artifactId>zkapp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.zkapp</groupId>
                <artifactId>zkapp-session</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.zkapp</groupId>
                <artifactId>zkapp-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.zkapp</groupId>
                <artifactId>zkapp-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.zkapp</groupId>
                <artifactId>zkapp-zk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.zkapp</groupId>
                <artifactId>zkapp-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ZK Framework -->
            <dependency>
                <groupId>org.zkoss.zk</groupId>
                <artifactId>zk</artifactId>
                <version>${zk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.zkoss.zk</groupId>
                <artifactId>zul</artifactId>
                <version>${zk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.zkoss.zk</groupId>
                <artifactId>zkbind</artifactId>
                <version>${zk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.zkoss.zk</groupId>
                <artifactId>zkplus</artifactId>
                <version>${zk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
